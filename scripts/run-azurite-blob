#!/bin/sh
# Persist data in the snap's writable per-user common directory by default.
# Listen host is taken from the snap "host" option (snap set azurite host=...).
HOST="$(snapctl get host 2>/dev/null || true)"
[ -z "$HOST" ] && HOST="127.0.0.1"
cd "${SNAP_USER_COMMON}" || exit 1
exec "${SNAP}/bin/azurite-blob" --blobHost "$HOST" "$@"